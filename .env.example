PORT=5180
HOST=0.0.0.0

# LLM inference. Default: Ollama on the host. Swap to LM Studio / llama-server by
# changing LLM_BASE_URL. Inside Docker, host services live at host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:14b
LLM_API_KEY=
# Set false if your model already has thinking suppressed via /chat/completions.
LLM_QWEN_MODE=true

# SQLite path inside the container. Bind-mount ./data → /app/data.
DB_PATH=/app/data/meal-planner.sqlite
